<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="120dp"
            android:height="120dp"
            android:viewportWidth="120"
            android:viewportHeight="120">

            <!-- Each ring is wrapped in a <group> so scaleX/scaleY works -->

            <!-- Outer ring group — pivoted at centre (60,60) -->
            <group
                android:name="group_outer"
                android:pivotX="60"
                android:pivotY="60"
                android:scaleX="1.0"
                android:scaleY="1.0">
                <path
                    android:pathData="M60,60m-45,0a45,45 0 1,0 90,0a45,45 0 1,0 -90,0"
                    android:strokeColor="#55F44336"
                    android:strokeWidth="2"
                    android:fillColor="@android:color/transparent" />
            </group>

            <!-- Middle ring group -->
            <group
                android:name="group_mid"
                android:pivotX="60"
                android:pivotY="60"
                android:scaleX="1.0"
                android:scaleY="1.0">
                <path
                    android:pathData="M60,60m-32,0a32,32 0 1,0 64,0a32,32 0 1,0 -64,0"
                    android:strokeColor="#77F44336"
                    android:strokeWidth="2.5"
                    android:fillColor="@android:color/transparent" />
            </group>

            <!-- Inner ring group -->
            <group
                android:name="group_inner"
                android:pivotX="60"
                android:pivotY="60"
                android:scaleX="1.0"
                android:scaleY="1.0">
                <path
                    android:pathData="M60,60m-20,0a20,20 0 1,0 40,0a20,20 0 1,0 -40,0"
                    android:strokeColor="#99F44336"
                    android:strokeWidth="3"
                    android:fillColor="@android:color/transparent" />
            </group>

        </vector>
    </aapt:attr>

    <!-- Outer group: scale + fade, most delayed -->
    <target android:name="group_outer">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.5"
                    android:valueTo="1.3"
                    android:duration="1400"
                    android:startOffset="300"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.5"
                    android:valueTo="1.3"
                    android:duration="1400"
                    android:startOffset="300"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="0.9"
                    android:valueTo="0"
                    android:duration="1400"
                    android:startOffset="300"
                    android:repeatCount="infinite"
                    android:repeatMode="restart" />
            </set>
        </aapt:attr>
    </target>

    <!-- Middle group: medium delay -->
    <target android:name="group_mid">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.6"
                    android:valueTo="1.2"
                    android:duration="1400"
                    android:startOffset="150"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.6"
                    android:valueTo="1.2"
                    android:duration="1400"
                    android:startOffset="150"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0"
                    android:duration="1400"
                    android:startOffset="150"
                    android:repeatCount="infinite"
                    android:repeatMode="restart" />
            </set>
        </aapt:attr>
    </target>

    <!-- Inner group: no delay, leads the pulse -->
    <target android:name="group_inner">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.7"
                    android:valueTo="1.1"
                    android:duration="1400"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.7"
                    android:valueTo="1.1"
                    android:duration="1400"
                    android:repeatCount="infinite"
                    android:repeatMode="restart"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="1.0"
                    android:valueTo="0"
                    android:duration="1400"
                    android:repeatCount="infinite"
                    android:repeatMode="restart" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>