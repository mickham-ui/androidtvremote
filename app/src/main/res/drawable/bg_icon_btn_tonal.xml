<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_icon_btn_tonal.xml
    Place in: res/drawable/bg_icon_btn_tonal.xml

    Provides:
      • Tonal filled background  →  colorSecondaryContainer
      • Rounded corners          →  12dp (adapts naturally at any size)
      • Ripple on press          →  colorOnSecondaryContainer @ 12% overlay

    Used by VOL ▲▼ and CH ▲▼ ImageButtons.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorPrimaryContainer">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerLow" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>

    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>
</ripple>
