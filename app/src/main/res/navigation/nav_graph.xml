<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.out.androidtvremote.ui.frags.remote.RemoteFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_remote" />

    <fragment
        android:id="@+id/navigation_cast"
        android:name="com.out.androidtvremote.ui.frags.cast.fragments.CastFragment"
        android:label="Casting"
        tools:layout="@layout/fragment_casting">

        <action
            android:id="@+id/action_castingFragment_to_videoFragment"
            app:destination="@id/videoFragment" />
        <action
            android:id="@+id/action_castingFragment_to_audioFragment"
            app:destination="@id/audioFragment" />
        <action
            android:id="@+id/action_castingFragment_to_photoFragment"
            app:destination="@id/photoFragment" />

    </fragment>
    <fragment
        android:id="@+id/videoFragment"
        android:name="com.out.androidtvremote.ui.frags.cast.fragments.CommonTabVideoFragment"
        android:label="Cast Video"
        tools:layout="@layout/fragment_video">
        <!--        <action-->
        <!--            android:id="@+id/action_SecondFragment_to_FirstFragment"-->
        <!--            app:destination="@id/navigation_cast" />-->

        <!--        <action-->
        <!--            android:id="@+id/action_videoFolderFragment_to_videoPlayerFragment"-->
        <!--            app:destination="@id/videoPlayerFragment" />-->
    </fragment>
    <fragment
        android:id="@+id/audioFragment"
        android:name="com.out.androidtvremote.ui.frags.cast.fragments.AudioFragment"
        android:label="Cast Audio"
        tools:layout="@layout/fragment_audio">

    </fragment>
    <fragment
        android:id="@+id/photoFragment"
        android:name="com.out.androidtvremote.ui.frags.cast.fragments.CommonTabImageFragment"
        android:label="Cast Photo"
        tools:layout="@layout/fragment_images">

    </fragment>

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.out.androidtvremote.ui.frags.settings.SettingsFragment"
        android:label="@string/settings" />


</navigation>