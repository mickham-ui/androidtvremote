<?xml version="1.0" encoding="utf-8"?>
<!--
    Material You 3 — Green seed color palette
    Generated from seed: #1B6E35 (Android Forest Green)

    Light theme colors live here.
    Dark theme overrides live in values-night/colors.xml.

    DO NOT use @color/black or @color/white for foreground/background content.
    Always use the ?attr/colorOnSurface / ?attr/colorOnBackground semantic tokens.
    @color/black and @color/white below are kept only for special
    non-themeable cases (e.g., animated vector drawables, splash icon fill).
-->
<resources>

    <!-- ── Absolute primitives (only use in drawables / icons) ── -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- ── Shimmer ───────────────────────────────────────────── -->
    <color name="shimmer_highlight_color">#C8E6C9</color>

    <!-- ── Semantic / functional colors ──────────────────────── -->
    <!-- Power icon: connected = green, disconnected = red -->
    <color name="power_connected_green">#2E7D32</color>
    <color name="power_disconnected_red">#C62828</color>

    <!-- Voice button active state -->
    <color name="voice_active_bg">#33388E3C</color>
    <color name="voice_active_icon">#388E3C</color>

    <!-- Button toggle state indicators (green-tuned) -->
    <color name="btn_state_active_green">#2E7D32</color>
    <color name="btn_state_mute_red">#B71C1C</color>
    <color name="btn_state_default_grey">#78909C</color>
    <color name="btn_bg_active_green">#2A2E7D32</color>
    <color name="btn_bg_mute_red">#2AB71C1C</color>

    <!-- Remote / D-Pad surface (adapts per mode via values-night) -->
    <color name="dpadcolorPrimary">#E8F5E9</color>
    <color name="remote_button_background">#C8E6C9</color>

    <!-- Glow accents (transparent = off; override in code for glow effects) -->
    <color name="expressive_glow_primary">#00000000</color>
    <color name="expressive_glow_secondary">#00000000</color>
    <color name="expressive_glow_tertiary">#00000000</color>

