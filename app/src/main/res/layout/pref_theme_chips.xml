<?xml version="1.0" encoding="utf-8"?>
<!--
    res/layout/pref_theme_chips.xml
    Uses only ?attr/ theme attributes — automatically adapts to light and dark mode.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Label row -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="App Theme"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose light, dark, or follow system setting"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="12dp" />

    <!-- Toggle group -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/themeButtonToggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeLight"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Light"
            android:textColor="@color/theme_toggle_text_color"
            app:strokeColor="?attr/colorOutlineVariant"

            app:iconGravity="textStart"
            app:iconTint="@color/theme_toggle_icon_color"
            app:backgroundTint="@color/theme_toggle_bg_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeSystem"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="System"
            android:textColor="@color/theme_toggle_text_color"
            app:strokeColor="?attr/colorOutlineVariant"

            app:iconGravity="textStart"
            app:iconTint="@color/theme_toggle_icon_color"
            app:backgroundTint="@color/theme_toggle_bg_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnThemeDark"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dark"
            android:textColor="@color/theme_toggle_text_color"
            app:strokeColor="?attr/colorOutlineVariant"

            app:iconGravity="textStart"
            app:iconTint="@color/theme_toggle_icon_color"
            app:backgroundTint="@color/theme_toggle_bg_color" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>