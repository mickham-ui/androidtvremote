<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/remoteLayoutToggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLayoutTouchpad"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Touchpad"
            android:textColor="@color/theme_toggle_text_color"
            app:strokeColor="?attr/colorOutlineVariant"
            app:iconGravity="textStart"
            app:iconTint="@color/theme_toggle_icon_color"
            app:backgroundTint="@color/theme_toggle_bg_color" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLayoutDPad"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="D-Pad"
            android:textColor="@color/theme_toggle_text_color"
            app:strokeColor="?attr/colorOutlineVariant"
            app:iconGravity="textStart"
            app:iconTint="@color/theme_toggle_icon_color"
            app:backgroundTint="@color/theme_toggle_bg_color" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</LinearLayout>
