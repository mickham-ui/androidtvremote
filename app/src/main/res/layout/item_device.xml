<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_device"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="20dp"
    app:cardElevation="1dp"
    app:rippleColor="?attr/colorPrimary"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_device_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardBackgroundColor="?attr/colorSecondaryContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_device_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_tv"
                app:tint="?attr/colorOnSecondaryContainer" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Device Information -->
        <LinearLayout
            android:id="@+id/layout_device_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layout_device_actions"
            app:layout_constraintStart_toEndOf="@+id/card_device_icon"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_device_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Living Room TV"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                tools:text="Living Room TV" />

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_device_model"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Android TV • Sony"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Android TV • Sony" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Signal Strength Indicator -->
                <View
                    android:id="@+id/view_signal_strength"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_shape"
                    android:backgroundTint="?attr/colorTertiary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_device_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="192.168.1.100"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="192.168.1.100" />

            </LinearLayout>

        </LinearLayout>

        <!-- Device Actions -->
        <LinearLayout
            android:id="@+id/layout_device_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Connect Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connect"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Connect"
                app:backgroundTint="?attr/colorPrimary"
                app:iconGravity="textStart"
                app:iconSize="20dp"
                android:visibility="gone"
                app:icon="@drawable/ic_device_tv"
                app:iconTint="?attr/colorOnPrimary" />

            <!-- Connecting Progress Indicator -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_connecting"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorPrimary"
                app:indicatorSize="24dp"
                app:trackColor="?attr/colorSurfaceVariant"
                app:trackCornerRadius="12dp" />

            <!-- Connected Status -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_connected"
                style="@style/Widget.Material3.Button.IconButton.Filled"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="Connected"
                android:visibility="gone"
                app:backgroundTint="?attr/colorTertiary"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:iconSize="20dp"

                app:iconTint="?attr/colorOnTertiary" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>